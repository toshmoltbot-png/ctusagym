[
  {
    "name": "Manny Bonilla",
    "years": "1978 - 2017",
    "tribute": "It is with great sadness that we inform you of the passing of Manny Bonilla after a courageous battle with cancer. Manny has coached for many years at C.A.T.S. and we offer our condolences and best wishes for his family, gymnasts, and gymnastics friends.",
    "link": "/docs/45aa9a_c72fb84e77ee402198cc475fe3d92c0e.pdf",
    "link_label": "Letter from Manny"
  },
  {
    "name": "Laurie Scanlon",
    "years": "1952 - 2015",
    "tribute": "Laurie, the co-owner of NEGX and GET, had been bravely battling cancer for approximately 10 years. Most of us will remember Laurie as the Master of Ceremonies at our Level 7 & 8 State Championships for several years, and just recently at our Level 7-10 State Championships in Newtown. Always focused on the gymnasts, Laurie never brought attention to herself or to her battle. We have lost a champion for kids.",
    "link": "",
    "link_label": ""
  },
  {
    "name": "Nina Poeta",
    "years": "1997 - 2014",
    "tribute": "It is with great sadness that we share the news of 17 year-old Nina Poeta passing away. Nina was a competitive gymnast in Connecticut with CSPA for nine years. She lost her fight with an inoperable brain tumor. USA Gymnastics-CT made a donation to the Nina Poeta Memorial Scholarship Fund in her honor.",
    "link": "",
    "link_label": ""
  },
  {
    "name": "Don Tonry",
    "years": "1935 - 2013",
    "tribute": "Don Tonry passed away May 17, 2013 at Yale New Haven Hospital. A 1960 Olympian, NCAA National Champion, and USA Hall of Fame inductee, Don transformed the Yale Gymnastic Club into a Varsity team that won three straight Ivy League Championships. He served as Yale's Associate Director for Physical Education and coached from his scooter while heroically battling Multiple Sclerosis. Don cared for all and was loved by all.",
    "link": "",
    "link_label": ""
  },
  {
    "name": "Dick Terry",
    "years": "1922 - 2012",
    "tribute": "Dick founded and coached the Milford Gymnastics program and was most instrumental in bringing about the sport of gymnastics statewide for Connecticut. He owned Terryettes Gymnastics in Hamden for many years and served as Assistant Coach for UB and SCSU gymnastics programs. He was an energetic and vibrant force in the world of gymnastics.",
    "link": "",
    "link_label": ""
  },
  {
    "name": "Joan Hicks",
    "years": "1936 - 2009",
    "tribute": "For over 30 years, Joan served as CT State Chairman for USA Gymnastics, twice winning the Silver Quill award. She coached at Grossfeld's Gymnastics, Polly's School of Gymnastics, and Yale University, where the team won its first Ivy League Championship of any women's sport. The CT High School Coaches established the Joan Hicks Award for the top high school gymnast in the state each year.",
    "link": "",
    "link_label": ""
  },
  {
    "name": "Ro Carlucci",
    "years": "1949 - 2007",
    "tribute": "Ro compiled 400 wins and three FCIAC titles as Westhill High School's gymnastics coach, was one of the sport's top judges, and is a member of the FCIAC Hall of Fame. She was a distinguished teacher who used her battle with breast cancer as a way to reaffirm her status as a role model. As she once said, 'I always found it better to leave a place better than you found it.'",
    "link": "",
    "link_label": ""
  }
]
