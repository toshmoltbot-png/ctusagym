---
layout: base.njk
title: Hall of Fame
permalink: /hall-of-fame/
description: CT USA Gymnastics Hall of Fame — honoring outstanding contributions to Connecticut gymnastics.
---

<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
  <div class="text-center">
    <img src="/images/photos/Hall_of_fame_LOGO_small.png" alt="CT USAG Hall of Fame" class="mx-auto h-auto w-48 sm:w-64">
    <h1 class="mt-6 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">Hall of Fame</h1>
    <p class="mt-2 text-sm text-slate-600">Honoring outstanding contributions to Connecticut gymnastics.</p>
  </div>

  <div class="mt-12 space-y-12">
    {% for classYear in hall_of_fame %}
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-black text-slate-900">{{ classYear.title }}</h2>

      {% if classYear.photo %}
      <div class="mt-4">
        <img src="{{ classYear.photo }}" alt="{{ classYear.title }}" class="w-full rounded-lg object-cover" loading="lazy">
      </div>
      {% endif %}

      <ul class="mt-6 space-y-4">
        {% for inductee in classYear.inductees %}
        <li>
          {% if inductee.bio and inductee.bio | length > 0 %}
          <details class="group rounded-lg border border-slate-100 bg-slate-50 p-4">
            <summary class="cursor-pointer list-none">
              <div class="flex items-center justify-between">
                <span class="text-sm font-bold text-slate-900">{{ inductee.name }}</span>
                <svg class="h-4 w-4 shrink-0 text-slate-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
              </div>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-700">{{ inductee.bio }}</p>
          </details>
          {% else %}
          <div class="rounded-lg border border-slate-100 bg-slate-50 p-4">
            <span class="text-sm font-bold text-slate-900">{{ inductee.name }}</span>
          </div>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </div>
</section>
