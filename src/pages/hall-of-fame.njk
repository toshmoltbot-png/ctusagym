---
layout: base.njk
title: Hall of Fame
permalink: /hall-of-fame/
description: CT USA Gymnastics Hall of Fame — honoring outstanding contributions to Connecticut gymnastics.
---

{# Hero Banner #}
<section class="border-b border-slate-200 bg-white">
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-14">
    <div class="flex flex-col items-center text-center">
      <img src="/images/photos/Hall_of_fame_LOGO_small.png" alt="CT USAG Hall of Fame" class="h-24 w-auto sm:h-28">
      <h1 class="mt-5 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">Connecticut Gymnastics Hall of Fame</h1>
      <p class="mt-2 max-w-xl text-sm text-slate-600">Honoring individuals who have made outstanding contributions to the sport of gymnastics in Connecticut.</p>
    </div>
  </div>
</section>

<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
  <div class="space-y-8">
    {% for classYear in hall_of_fame %}

    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      {% if classYear.photo %}
      {# Card with photo #}
      <div class="sm:flex">
        <div class="sm:w-2/5 flex-shrink-0">
          <img src="{{ classYear.photo }}" alt="{{ classYear.title }}" class="aspect-[4/3] w-full object-cover" loading="lazy">
        </div>
        <div class="flex flex-col justify-center p-6 sm:w-3/5">
          <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-[color:var(--usag-red)]">Inducted</p>
          <h2 class="mt-1 text-xl font-black text-slate-900">{{ classYear.title }}</h2>
          <ul class="mt-3 space-y-1">
            {% for inductee in classYear.inductees %}
            <li class="text-sm text-slate-700">{{ inductee.name }}</li>
            {% endfor %}
          </ul>
          {% if classYear.dropbox %}
          <a href="{{ classYear.dropbox }}" class="mt-4 inline-flex items-center gap-2 text-xs font-bold text-[color:var(--usag-red)] hover:underline" target="_blank" rel="noopener">View Photos &rarr;</a>
          {% endif %}
        </div>
      </div>
      {# Extra photos #}
      {% if classYear.extra_photos %}
      <div class="border-t border-slate-200 grid grid-cols-2 gap-px bg-slate-200">
        {% for photo in classYear.extra_photos %}
        <div class="bg-white">
          <img src="{{ photo }}" alt="{{ classYear.title }}" class="w-full object-cover aspect-[16/9]" loading="lazy">
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% else %}
      {# Card without photo #}
      <div class="p-6">
        <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-[color:var(--usag-red)]">Inducted</p>
        <h2 class="mt-1 text-xl font-black text-slate-900">{{ classYear.title }}</h2>
        <ul class="mt-3 space-y-1">
          {% for inductee in classYear.inductees %}
          <li class="text-sm text-slate-700">{{ inductee.name }}</li>
          {% endfor %}
        </ul>
        {% if classYear.dropbox %}
        <a href="{{ classYear.dropbox }}" class="mt-4 inline-flex items-center gap-2 text-xs font-bold text-[color:var(--usag-red)] hover:underline" target="_blank" rel="noopener">View Photos &rarr;</a>
        {% endif %}
      </div>
      {% endif %}

      {# Expandable bios #}
      {% for inductee in classYear.inductees %}
        {% if inductee.bio and inductee.bio | length > 50 %}
        <div class="border-t border-slate-200">
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-3.5 transition hover:bg-blue-50">
              <span class="text-sm font-bold text-blue-700 underline decoration-blue-300 underline-offset-4 group-hover:decoration-blue-700">Read {{ inductee.name }}&rsquo;s Biography</span>
              <svg class="h-4 w-4 flex-shrink-0 text-blue-500 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="border-t border-slate-100 bg-slate-50 px-6 py-5">
              <p class="max-w-3xl text-sm leading-7 text-slate-700">{{ inductee.bio }}</p>
            </div>
          </details>
        </div>
        {% endif %}
      {% endfor %}
    </div>

    {% endfor %}
  </div>

  {# Wall of Remembrance #}
  <div class="mt-16">
    <h2 class="text-2xl font-black tracking-tight text-slate-900 text-center">Wall of Remembrance</h2>
    <p class="mt-2 text-sm text-slate-600 text-center">In loving memory of those who gave so much to Connecticut gymnastics.</p>
    <div class="mt-8 space-y-4">
      {% for person in wall_of_remembrance %}
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="text-sm font-black text-slate-900">{{ person.name }}</h3>
          <span class="text-xs font-semibold text-slate-500 flex-shrink-0">{{ person.years }}</span>
        </div>
        <p class="mt-2 text-sm leading-6 text-slate-600">{{ person.tribute }}</p>
        {% if person.link %}
        <a href="{{ person.link }}" class="mt-3 inline-flex items-center gap-1 text-xs font-bold text-[color:var(--usag-red)] hover:underline" target="_blank" rel="noopener">{{ person.link_label }} &rarr;</a>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
