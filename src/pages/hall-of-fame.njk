---
layout: base.njk
title: Hall of Fame
permalink: /hall-of-fame/
description: CT USA Gymnastics Hall of Fame — honoring outstanding contributions to Connecticut gymnastics.
---

{# Hero Banner #}
<section class="border-b border-slate-200 bg-white">
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-14">
    <div class="flex flex-col items-center text-center">
      <img src="/images/photos/Hall_of_fame_LOGO_small.png" alt="CT USAG Hall of Fame" class="h-24 w-auto sm:h-28">
      <h1 class="mt-5 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">Connecticut Gymnastics Hall of Fame</h1>
      <p class="mt-2 max-w-xl text-sm text-slate-600">Honoring individuals who have made outstanding contributions to the sport of gymnastics in Connecticut.</p>
    </div>
  </div>
</section>

<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
  <div class="space-y-10">
    {% for classYear in hall_of_fame | reverse %}

    {# Skip classes with only TBA entries #}
    {% set hasBio = false %}
    {% for inductee in classYear.inductees %}
      {% if inductee.bio and inductee.bio != "2025 Hall of Fame class details to be announced." %}
        {% set hasBio = true %}
      {% endif %}
    {% endfor %}

    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      {# Class header with photo #}
      {% if classYear.photo %}
      <div class="sm:flex">
        <div class="sm:w-2/5">
          <img src="{{ classYear.photo }}" alt="{{ classYear.title }}" class="aspect-[4/3] w-full object-cover" loading="lazy">
        </div>
        <div class="flex flex-col justify-center p-6 sm:w-3/5">
          <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-[color:var(--usag-red)]">Inducted</p>
          <h2 class="mt-1 text-xl font-black text-slate-900">{{ classYear.title }}</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {% for inductee in classYear.inductees %}
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">{{ inductee.name }}</span>
            {% endfor %}
          </div>
        </div>
      </div>
      {% else %}
      <div class="p-6">
        <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-[color:var(--usag-red)]">Inducted</p>
        <h2 class="mt-1 text-xl font-black text-slate-900">{{ classYear.title }}</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {% for inductee in classYear.inductees %}
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">{{ inductee.name }}</span>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {# Bios section #}
      {% for inductee in classYear.inductees %}
        {% if inductee.bio and inductee.bio | length > 50 %}
        <div class="border-t border-slate-100">
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between px-6 py-4 transition hover:bg-slate-50">
              <span class="text-sm font-bold text-slate-900">{{ inductee.name }} — Biography</span>
              <svg class="h-4 w-4 shrink-0 text-slate-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="border-t border-slate-100 bg-slate-50 px-6 py-5">
              <p class="max-w-3xl text-sm leading-7 text-slate-700">{{ inductee.bio }}</p>
            </div>
          </details>
        </div>
        {% endif %}
      {% endfor %}
    </div>

    {% endfor %}
  </div>

  {# Dropbox photos link #}
  <div class="mt-10 rounded-xl border border-slate-200 bg-white p-6 shadow-sm text-center">
    <h2 class="text-sm font-black text-slate-900">Hall of Fame Photo Albums</h2>
    <p class="mt-2 text-xs text-slate-600">View ceremony photographs from past induction classes.</p>
    <a href="https://www.dropbox.com/scl/fo/bwxi3hw3veejmmtlj7ze8/ADxEpyse7ERqxN4-agfvxjw?rlkey=c4fceqdg7dzs2noc0j0dnpiut&dl=0" class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-[color:var(--usag-red)] hover:underline" target="_blank" rel="noopener">View Photos on Dropbox &rarr;</a>
  </div>
</section>
