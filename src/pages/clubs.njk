---
layout: base.njk
title: Clubs
permalink: /clubs/
description: Official directory of registered CT USA Gymnastics clubs. Search by club name, city, or ZIP code.
---

<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
  <h1 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">Clubs Directory</h1>
  <p class="mt-2 text-sm text-slate-600">Official directory of registered clubs. Click a club to open its website in a new tab. If a listing needs to be updated, please contact the State Committee.</p>

  {# Search #}
  <div class="mt-6 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <label for="club-search" class="block text-sm font-bold text-slate-900">Search Connecticut clubs</label>
    <input
      id="club-search"
      type="search"
      autocomplete="off"
      placeholder="Club name, city, or ZIP code"
      class="mt-2 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[color:var(--usag-red)]">
    <p id="club-count" class="mt-2 text-xs text-slate-500" aria-live="polite">Showing all {{ clubs | length }} clubs</p>
  </div>

  <div class="mt-8 space-y-4" id="club-directory">
    {% for club in clubs %}
    <div class="club-entry club-card relative rounded-xl border border-slate-200 bg-white p-4 shadow-sm{% if club.website %} club-card--linked{% endif %}" data-club="{{ club.name }} {{ club.city }} {{ club.zip }} {{ club.address }}">
      <h2 class="text-sm font-bold text-slate-900">
        {%- if club.website -%}
        <a href="https://{{ club.website }}" class="club-card-link" target="_blank" rel="noopener" title="Opens {{ club.name }} in a new tab">{{ club.name }}<span class="sr-only"> (opens in a new tab)</span></a>
        {%- else -%}
        {{ club.name }}
        {%- endif -%}
        {% if club.note %} <span class="text-xs font-normal text-slate-500">({{ club.note }})</span>{% endif %}
      </h2>
      {% if club.address %}
      <div class="mt-2 space-y-1 text-xs text-slate-600">
        <div>{{ club.address }}</div>
        <div>{{ club.city }}, {{ club.state }} {{ club.zip }}</div>
        {% if club.phone %}<div><a href="tel:{{ club.phone | replace(" ", "") }}" class="club-card-inline font-semibold text-slate-900 underline decoration-slate-300 underline-offset-4 hover:decoration-slate-900">{{ club.phone }}</a></div>{% endif %}
        {% if club.website %}<div><span class="club-card-inline font-semibold text-slate-900 underline decoration-slate-300 underline-offset-4">{{ club.website }}</span></div>{% endif %}
        {% if club.email %}<div><a href="mailto:{{ club.email }}" class="club-card-inline font-semibold text-slate-900 underline decoration-slate-300 underline-offset-4 hover:decoration-slate-900">{{ club.email }}</a></div>{% endif %}
        {% if club.contact %}<div>Att: {{ club.contact }}</div>{% endif %}
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  <p id="club-empty" class="mt-6 hidden text-sm text-slate-600">No clubs match that search. Try a club name, city, or ZIP code.</p>
</section>

<script>
(function () {
  var input = document.getElementById('club-search');
  var entries = Array.prototype.slice.call(document.querySelectorAll('.club-entry'));
  var count = document.getElementById('club-count');
  var empty = document.getElementById('club-empty');
  if (!input || !entries.length) return;

  function apply() {
    var q = input.value.trim().toLowerCase();
    var shown = 0;
    entries.forEach(function (el) {
      var hit = !q || (el.getAttribute('data-club') || '').toLowerCase().indexOf(q) !== -1;
      el.hidden = !hit;
      if (hit) shown++;
    });
    empty.classList.toggle('hidden', shown !== 0);
    count.textContent = q
      ? shown + (shown === 1 ? ' club matches ' : ' clubs match ') + '"' + input.value.trim() + '"'
      : 'Showing all ' + entries.length + ' clubs';
  }

  input.addEventListener('input', apply);
  apply();
})();
</script>
