      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <a href="/docs/ct-meet-director-guidelines.pdf" class="flex items-center gap-3 rounded-md border border-slate-200 p-4 text-sm font-semibold text-slate-800 transition hover:bg-slate-50">
          <span class="text-lg" aria-hidden="true">&#x1F4C4;</span> CT Meet Director Guidelines (PDF)
        </a>
        <a href="/docs/ct-meet-director-checklist.pdf" class="flex items-center gap-3 rounded-md border border-slate-200 p-4 text-sm font-semibold text-slate-800 transition hover:bg-slate-50">
          <span class="text-lg" aria-hidden="true">&#x1F4C4;</span> Meet Director Checklist (PDF)
        </a>
        <a href="https://static.usagym.org/PDFs/Women/Rules/rp/rulespolicies.pdf" class="flex items-center gap-3 rounded-md border border-slate-200 p-4 text-sm font-semibold text-slate-800 transition hover:bg-slate-50" target="_blank" rel="noopener">
          <span class="text-lg" aria-hidden="true">&#x2197;</span> Rules &amp; Policies 2025-26 (USAG)
        </a>
        <a href="https://static.usagym.org/PDFs/Member%20Services/requirements_table.pdf" class="flex items-center gap-3 rounded-md border border-slate-200 p-4 text-sm font-semibold text-slate-800 transition hover:bg-slate-50" target="_blank" rel="noopener">
          <span class="text-lg" aria-hidden="true">&#x2197;</span> Membership Requirement Guide (USAG)
        </a>
        <a href="https://www.usagym.org/PDFs/Women/Rules/Rules%20and%20Policies/w-meetorgguide.pdf" class="flex items-center gap-3 rounded-md border border-slate-200 p-4 text-sm font-semibold text-slate-800 transition hover:bg-slate-50" target="_blank" rel="noopener">
