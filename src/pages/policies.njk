---
layout: base.njk
title: Competition Policies
permalink: /policies/
description: Connecticut USA Gymnastics competition rules, entry procedures, qualification scores, dress code, age group policies, and meet director responsibilities.
---

{# Hero Banner #}
<section class="border-b border-slate-200 bg-white">
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-14">
    <div class="max-w-3xl">
      <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-[color:var(--usag-red)]">{{ policies_page.eyebrow }}</p>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">{{ policies_page.heading }}</h1>
      <p class="mt-4 text-base leading-7 text-slate-600">{{ policies_page.intro }}</p>
    </div>
    {# Quick jump - built automatically from the sections below #}
    <div class="mt-8 flex flex-wrap gap-2">
      {% for section in policies %}{% if section.jump_label %}
      <a href="#{{ section.anchor }}" class="rounded-full bg-slate-100 px-4 py-2 text-xs font-bold text-slate-800 hover:bg-slate-200">{{ section.jump_label | safe }}</a>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
  <div class="space-y-8">

    {% for section in policies %}
    <div id="{{ section.anchor }}" class="scroll-mt-24 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-black tracking-tight text-slate-950">{{ section.title | safe }}{% if section.block == "fees_table" and site.fees_season_label %} ({{ site.fees_season_label }}){% endif %}</h2>

      {% if section.content %}
      <div class="policy-prose mt-3">{{ section.content | safe }}</div>
      {% endif %}

      {# Entry fees table #}
      {% if section.block == "fees_table" %}
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="py-2 pr-4 text-left font-black text-slate-900">Level</th>
              <th class="py-2 pr-4 text-right font-black text-slate-900">Local</th>
              <th class="py-2 text-right font-black text-slate-900">State</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {% for row in fees %}
            <tr>
              <td class="py-2 pr-4 text-slate-700">{{ row.level }}</td>
              <td class="py-2 pr-4 text-right font-semibold text-slate-900">{{ row.local }}</td>
              <td class="py-2 text-right font-semibold text-slate-900">{{ row.state }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

      {# Qualification scores table #}
      {% if section.block == "qualification_table" %}
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="py-2 pr-4 text-left font-black text-slate-900">Program</th>
              <th class="py-2 text-right font-black text-slate-900">Score</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {% for row in qualification_scores %}
            <tr>
              <td class="py-2 pr-4 text-slate-700">{{ row.program }}</td>
              <td class="py-2 text-right font-semibold text-slate-900">{{ row.score }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

      {# Documents grid #}
      {% if section.block == "documents_grid" %}
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {% for doc in section.links %}
        <a href="{{ doc.link_url }}" class="flex items-center gap-3 rounded-md border border-slate-200 p-4 text-sm font-semibold text-slate-800 transition hover:bg-slate-50"{% if doc.external %} target="_blank" rel="noopener"{% endif %}>
          <span class="text-lg" aria-hidden="true">{% if doc.external %}&#x2197;{% else %}&#x1F4C4;{% endif %}</span> {{ doc.link_text }}
        </a>
        {% endfor %}
      </div>
      {% endif %}

      {# Highlighted callout box #}
      {% if section.callout %}
      <div class="policy-prose policy-callout mt-4 rounded-md bg-slate-50 p-4">{{ section.callout | safe }}</div>
      {% endif %}

      {# Additional notes below the main content #}
      {% if section.content_after %}
      <div class="policy-prose mt-5 border-t border-slate-100 pt-4">{{ section.content_after | safe }}</div>
      {% endif %}

      {# Small info cards (used by Admission Fees) #}
      {% if section.cards | length %}
      <div class="mt-6 border-t border-slate-100 pt-4">
        {% if section.cards_title %}<h3 class="text-sm font-black text-slate-900">{{ section.cards_title }}</h3>{% endif %}
        {% if section.cards_intro %}<p class="mt-1 text-sm text-slate-600">{{ section.cards_intro }}</p>{% endif %}
        <div class="mt-3 grid gap-3 sm:grid-cols-3">
          {% for card in section.cards %}
          <div class="rounded-md bg-slate-50 p-3">
            <div class="text-xs font-bold uppercase tracking-wide text-slate-500">{{ card.card_label }}</div>
            <div class="mt-1 text-sm text-slate-700">{{ card.card_text }}</div>
          </div>
          {% endfor %}
        </div>
        {% if section.cards_footnote %}<p class="mt-2 text-xs text-slate-500">{{ section.cards_footnote }}</p>{% endif %}
      </div>
      {% endif %}
    </div>
    {% endfor %}

  </div>
</section>
