{# Hero Banner #}
<section class="border-b border-slate-200 bg-white">
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-14">
    <div class="max-w-3xl">
      <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-[color:var(--usag-red)]">Official State Governance</p>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">About Connecticut Women&rsquo;s USA Gymnastics</h1>
      <p class="mt-4 text-base leading-7 text-slate-600">Supporting Connecticut athletes, coaches, judges, clubs, and sanctioned events through clear state procedures, committee leadership, education, and athlete safety resources.</p>
    </div>
    <div class="mt-8 grid gap-4 border-y border-slate-200 py-5 text-sm sm:grid-cols-3">
      <div>
        <div class="font-black text-slate-950">State Committee Term</div>
        <div class="mt-1 text-slate-600">7/1/2025 &ndash; 6/30/2027</div>
      </div>
      <div>
        <div class="font-black text-slate-950">Committee Scope</div>
        <div class="mt-1 text-slate-600">Competition procedures, state meets, clinics, and member communication</div>
      </div>
      <div>
        <div class="font-black text-slate-950">Resources</div>
        <div class="mt-1 text-slate-600">Meeting minutes, policy highlights, and qualification standards</div>
      </div>
    </div>
  </div>
</section>

<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
    {# Main column #}
    <div class="space-y-10">

      {# Intro text #}
      <div class="max-w-3xl text-sm leading-6 text-slate-600">
        <p>The Connecticut State Administrative Committee determines state competition procedures within the framework of USA Gymnastics National and Regional Rules &amp; Policies. The committee meets each June to set policies and schedules for the following year and is polled throughout the year on regional judging assignments, state meet panels, and other issues as they arise.</p>
        <p class="mt-3">Committee members with public email addresses have a contact link next to their name. For general inquiries, contact State Chairman Kim Vaillancourt. If you have questions or concerns, please put them in writing as their job is to represent the membership.</p>
      </div>

      {# Committee Members #}
      <section>
        <h2 class="text-2xl font-black tracking-tight text-slate-950">State Committee</h2>
        <div class="mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">

          {% set members = [
            { "name": "Kim Vaillancourt", "role": "State Chairman", "email": "kimvail45@gmail.com", "emailLabel": "Email State Chairman", "duties": "Fulfills the responsibilities assigned in USA Gymnastics Rules & Policies, attends required regional and national functions, manages state finances, conducts committee votes, approves and publishes the state schedule, tracks qualification and mobility scores, receives state championship bids, oversees host selection, serves as the official USAG state representative at State Championships or appoints a designee, and works with the webmaster to maintain the website and send membership notices." },
            { "name": "Gina D'Ambrosio", "role": "Vice Chairman (also Secretary)", "duties": "Supports the State Chair in all areas, especially State Committee meetings. Serves as Secretary by recording minutes and maintaining Connecticut-specific rules and policies under State Committee direction. Represents the state when the State Chair is unavailable." },
            { "name": "Laurie Defrancesco", "role": "Competition Chairman", "duties": "Serves as the USAG state representative at State Championships when the State Chair is unavailable, assists with state-run competitions, collects and tracks scores for mobility and state qualification, and provides meet directors with guidance on logistics and best practices." },
            { "name": "Natasha Kovach", "role": "Levels 9/10 Coaching Representative", "duties": "Represents the Level 9/10 and Elite programs. Works with regional leadership and the CT judging representative to develop clinics and educational opportunities, recommends policy updates, helps ensure adequate in-state competitive opportunities before State Meets, communicates updates to the membership, attends regional activities, and assists with regional meet apparel sizing." },
            { "name": "Pat Panichas", "role": "Level 9/10 Judging Representative", "email": "panichas@aol.com", "emailLabel": "Email Level 9/10 Judging Representative", "duties": "Represents Level 9/10 and Elite judging and must hold a Brevet or National rating. Works with regional staff and the CT coaching representative to develop clinics and educational opportunities, keeps the membership informed of updates, may serve as Meet Referee for Level 9/10 States, and presents eligible and available State Championship officials to the committee." },
            { "name": "Maureen Chagnon", "role": "Levels 6/7/8 Coaching Representative", "duties": "Represents Levels 6/7/8 coaching. Works with the Clinician Coordinator to develop clinics and educational opportunities, recommends policy updates, helps ensure adequate in-state competitive opportunities before State Meets, communicates updates to the membership, attends regional activities, assists with Level 9/10 Regional entries, and helps with regional meet apparel sizing." },
            { "name": "Lorraine Duffy", "role": "Levels 6/7/8 Judging Representative", "duties": "Represents Levels 6/7/8 judging and must hold at least a Level 10 rating. Works with the coaching representative and Clinician Coordinator to develop clinics and educational opportunities, communicates updates to the membership, may serve as Meet Referee for Level 6/7/8 States, and presents eligible and available State Championship officials to the committee." },
            { "name": "Jacquelyn Kiug", "role": "Compulsory Coaching Representative", "duties": "Represents compulsory coaching. Works with the judging representative and Clinician Coordinator to develop clinics and educational opportunities, communicates updates to the membership, shares NAWGJ new-judge clinic information with clubs, and presents recommended policy changes to the committee." },
            { "name": "Victor Gemini-Netto", "role": "Xcel Coaching Representative", "duties": "Represents Xcel coaching. Works with the judging representative to develop clinics and educational opportunities, communicates updates to the membership, shares NAWGJ new-judge clinic information with clubs, recommends policy changes to the committee, and assists with regional meet apparel sizing." },
            { "name": "Kathy Bielert", "role": "Compulsory Judging Representative", "duties": "Represents compulsory judging and must hold at least a Level 9 rating. Works with the coaching representative and Clinician Coordinator to develop clinics and educational opportunities, communicates updates to the membership, and presents eligible and available State Championship officials to the committee." },
            { "name": "Jamie-Lee Lagoy", "role": "Xcel Judging Representative", "duties": "Represents Xcel judging and must hold at least a Level 9 rating. Works with the coaching representative to develop clinics and educational opportunities, communicates updates to the membership, and presents eligible and available State Championship officials to the committee." },
            { "name": "Maureen Pokorny", "role": "All-Members At Large", "duties": "Represents the general USAG-CT membership rather than a specific club, region, or group. Contributes to committee discussion, voting, planning, event support, policy work, and community engagement while gathering feedback so broader member perspectives are reflected in leadership decisions." },
            { "name": "Brock Freehling", "role": "State Clinician Coordinator", "duties": "Plans and executes state clinics across competitive levels. Works with committee members to organize clinic sites and coordinate clinicians so training is available for both coaches and judges." },
            { "name": "Mark Sorrentino", "role": "Informational Media (Webmaster)", "email": "Markytino40@gmail.com", "emailLabel": "Email Webmaster", "duties": "Updates and maintains the state committee website in coordination with the State Chair. Posts approved content, implements requested changes, keeps information accurate and current, monitors website functionality and usability, suggests structural improvements when helpful, and maintains an organized backend for current materials." }
          ] %}

          {% for member in members %}
          <details class="group border-slate-200 {% if not loop.first %}border-t{% endif %}">
            <summary class="grid cursor-pointer list-none gap-x-4 gap-y-1 px-4 py-4 transition hover:bg-slate-50 sm:grid-cols-[1fr_auto] sm:items-center sm:px-5">
              <div class="min-w-0">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="text-sm font-black text-slate-950">{{ member.name }}</span>
                  <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ member.role }}</span>
                </div>
                {% if member.email %}
                <div class="mt-1.5 flex flex-wrap items-center gap-3">
                  <a href="mailto:{{ member.email }}" class="text-xs font-bold text-[color:var(--usag-red)] underline decoration-[color:var(--usag-red)]/30 underline-offset-4 hover:decoration-[color:var(--usag-red)]" onclick="event.stopPropagation()">{{ member.emailLabel }}</a>
                </div>
                {% endif %}
              </div>
              <div class="flex items-center gap-1 self-center justify-self-end">
                <span class="text-xs font-black uppercase tracking-wide text-[color:var(--usag-red)] group-open:hidden">Duties &#x25BC;</span>
                <span class="hidden text-xs font-black uppercase tracking-wide text-slate-400 group-open:inline">Hide &#x25B2;</span>
              </div>
            </summary>
            <div class="border-t border-slate-100 bg-slate-50 px-4 py-4 sm:px-5">
              <p class="max-w-3xl text-sm leading-6 text-slate-700">{{ member.duties }}</p>
            </div>
          </details>
          {% endfor %}

        </div>

        {# Election notes #}
        <div class="mt-5 rounded-lg border border-slate-200 bg-white p-4 text-sm leading-6 text-slate-600 shadow-sm">
          <div class="font-black text-slate-950">State Committee election notes</div>
          <p class="mt-1">Committee members are elected by the entire state professional membership for a two-year term concurrent with the State Chair. Each committee member has one vote; simple majority passes motions; State Chair votes only to break ties.</p>
        </div>
      </section>

