---
layout: base.njk
title: Calendar
permalink: /calendar/
description: Season calendar for Connecticut Women's USA Gymnastics meets and events.
---

<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
  <h1 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">Season Calendar</h1>
  <p class="mt-2 text-sm text-slate-600">A clear, mobile-first listing of meets with quick access to details and forms.</p>

  {# Filter Buttons #}
  <div class="mt-6 flex flex-wrap gap-2" id="calendar-filters">
    <button type="button" data-filter="all" class="rounded-md px-3 py-2 text-sm font-semibold bg-slate-900 text-white" onclick="filterCalendar('all')">All</button>
    <button type="button" data-filter="sanctioned" class="rounded-md px-3 py-2 text-sm font-semibold bg-slate-100 text-slate-800 hover:bg-slate-200" onclick="filterCalendar('sanctioned')">Sanctioned</button>
    <button type="button" data-filter="pending" class="rounded-md px-3 py-2 text-sm font-semibold bg-slate-100 text-slate-800 hover:bg-slate-200" onclick="filterCalendar('pending')">Pending</button>
  </div>

  {% set grouped = calendar | groupByMonth %}
  {% for group in grouped %}
  <h2 class="mt-10 text-lg font-black text-slate-900">{{ group.month }}</h2>
  <ul class="mt-4 space-y-3">
    {% for event in group.items %}
    <li class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm" data-status="{{ event.status }}">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-sm font-bold text-slate-900">{{ event.name }}</span>
          {% if event.status == "sanctioned" %}
          <span class="rounded-full bg-green-50 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-green-700">sanctioned</span>
          {% elif event.status == "pending" %}
          <span class="rounded-full bg-yellow-50 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-yellow-700">pending</span>
          {% endif %}
        </div>
        <div class="mt-1 text-xs text-slate-600">{{ event.start | dateRange(event.end) }} &bull; {{ event.host }}, {{ event.state }} &bull; {{ event.location }}</div>
      </div>
    </li>
    {% endfor %}
  </ul>
  {% endfor %}

  <script>
    function filterCalendar(status) {
      var items = document.querySelectorAll('[data-status]');
      items.forEach(function(item) {
        if (status === 'all' || item.getAttribute('data-status') === status) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
      var buttons = document.querySelectorAll('#calendar-filters button');
      buttons.forEach(function(btn) {
        if (btn.getAttribute('data-filter') === status) {
          btn.className = 'rounded-md px-3 py-2 text-sm font-semibold bg-slate-900 text-white';
        } else {
          btn.className = 'rounded-md px-3 py-2 text-sm font-semibold bg-slate-100 text-slate-800 hover:bg-slate-200';
        }
      });
    }
  </script>
</section>
