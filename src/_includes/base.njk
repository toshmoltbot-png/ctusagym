<!DOCTYPE html>
<html lang="en" class="h-full scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description or site.description }}">
  <meta name="color-scheme" content="light">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ title }} | {{ site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:image" content="{{ site.url }}/images/ct-usag-logo-clr.png">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="en_US">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body class="min-h-full bg-slate-50 text-slate-900 antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-slate-900 focus:shadow">Skip to content</a>
  <div class="flex min-h-screen flex-col">
    {% include "header.njk" %}
    <main id="main" class="flex-1">
      {{ content | safe }}
    </main>
    {% include "footer.njk" %}
  </div>
</body>
</html>
