<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex h-16 items-center justify-between gap-6">
      <a href="/" class="flex shrink-0 items-center gap-3">
        <img src="/images/ct-usag-logo-clr-horiz.png" width="4273" height="589" alt="Connecticut USA Gymnastics" class="h-auto w-[220px] max-w-[55vw] shrink-0" loading="eager" decoding="async">
        <span class="sr-only">Connecticut Women's USA Gymnastics</span>
      </a>
      <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
        {% for item in navigation.main %}
          {% if item.children %}
          <div class="nav-dropdown relative">
            <button
              type="button"
              class="inline-flex items-center gap-1 whitespace-nowrap rounded-md px-3 py-2 text-sm font-semibold transition {% if page.url == item.url %}bg-slate-900 text-white{% else %}text-slate-700 hover:bg-slate-100 hover:text-slate-900{% endif %}"
            >
              {{ item.label }}
              <svg class="h-3.5 w-3.5 opacity-50" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="nav-dropdown-menu absolute left-0 top-full z-50 hidden pt-1">
              <div class="min-w-[180px] rounded-lg border border-slate-200 bg-white py-1 shadow-lg">
                {% for child in item.children %}
                <a href="{{ child.url }}" class="block px-4 py-2 text-sm font-medium transition {% if page.url == child.url %}bg-slate-50 font-bold text-slate-900{% else %}text-slate-700 hover:bg-slate-50 hover:text-slate-900{% endif %}"{% if page.url == child.url %} aria-current="page"{% endif %}>
                  {{ child.label }}
                </a>
                {% endfor %}
              </div>
            </div>
          </div>
          {% else %}
          <a href="{{ item.url }}" class="whitespace-nowrap rounded-md px-3 py-2 text-sm font-semibold transition {% if page.url == item.url %}bg-slate-900 text-white{% else %}text-slate-700 hover:bg-slate-100 hover:text-slate-900{% endif %}"{% if page.url == item.url %} aria-current="page"{% endif %}>
            {{ item.label }}
          </a>
          {% endif %}
        {% endfor %}
      </nav>
      <div class="flex items-center gap-2">
        <a href="/resources/" class="inline-flex items-center rounded-md bg-[color:var(--usag-red)] px-3 py-2 text-sm font-semibold text-white shadow-sm transition hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-[color:var(--usag-red)] focus:ring-offset-2">Quick Links</a>
      </div>
    </div>
    <nav class="-mx-2 flex gap-2 overflow-x-auto border-t border-slate-100 px-2 py-2 lg:hidden" aria-label="Primary">
      {% for item in navigation.main %}
        {% if item.children %}
          {% for child in item.children %}
          <a href="{{ child.url }}" class="whitespace-nowrap rounded-md px-3 py-2 text-sm font-semibold {% if page.url == child.url %}bg-slate-900 text-white{% else %}bg-slate-100 text-slate-800{% endif %}"{% if page.url == child.url %} aria-current="page"{% endif %}>
            {{ child.label }}
          </a>
          {% endfor %}
        {% else %}
        <a href="{{ item.url }}" class="whitespace-nowrap rounded-md px-3 py-2 text-sm font-semibold {% if page.url == item.url %}bg-slate-900 text-white{% else %}bg-slate-100 text-slate-800{% endif %}"{% if page.url == item.url %} aria-current="page"{% endif %}>
          {{ item.label }}
        </a>
        {% endif %}
      {% endfor %}
    </nav>
  </div>
</header>

<style>
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu {
    display: block;
  }
</style>
