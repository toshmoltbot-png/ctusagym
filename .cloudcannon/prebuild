#!/usr/bin/env bash
# CloudCannon prebuild hook.
# Recompiles Tailwind CSS from src/assets/css/tailwind.css before Eleventy runs.
# Without this, editing a template that introduces a new utility class would
# produce unstyled output, because the cdn.tailwindcss.com fallback was removed.
#
# Deliberately NOT using 'set -e': a CSS rebuild failure must never take the
# whole site build down. src/assets/css/site.css is committed, so if this step
# fails the build still ships the last good stylesheet.
set -uo pipefail

echo "prebuild: compiling Tailwind CSS"

if [ ! -x node_modules/.bin/tailwindcss ]; then
  echo "prebuild: tailwindcss not present, installing dev dependencies"
  npm install --no-audit --no-fund || echo "prebuild: npm install failed, continuing"
fi

if [ -x node_modules/.bin/tailwindcss ]; then
  if node_modules/.bin/tailwindcss \
      -i src/assets/css/tailwind.css \
      -o src/assets/css/site.css --minify; then
    echo "prebuild: CSS compiled"
  else
    echo "prebuild: CSS compile FAILED, keeping committed site.css"
  fi
else
  echo "prebuild: tailwindcss unavailable, keeping committed site.css"
fi

exit 0
